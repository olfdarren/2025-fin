        "def fibonacci(n):\n",
        "    if n<=2:\n",
        "        print('please enter a number which is greater than 2!')\n",
        "    else:\n",
        "        fib = [1,1]\n",
        "        ratio = [1]\n",
        "        for i in range(n):\n",
        "            fib_new = fib[i-1] + fib[i-2]\n",
        "            fib.append(fib_new)\n",
        "            ratio_new = fib[i-1] / fib_new\n",
        "            ratio.append(ratio_new)\n",
        "        print(fib)\n",
        "        print(ratio)"
      ]
